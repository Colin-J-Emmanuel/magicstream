MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=magicstream

# LLM provider: any OpenAI-compatible endpoint. Pick one block.

# Groq (default): fast, free tier with no credit card. Get a key at console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Google Gemini (tested alternative): free tier at aistudio.google.com
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=models/gemini-3.5-flash -> this is one of the many models you can pick from

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
COOKIE_SECURE=false